# API Configuration
PORT=3000
NODE_ENV=production

# Algorand Network Configuration (using Nodely - Mainnet)
ALGORAND_NETWORK=mainnet
ALGOD_SERVER=https://mainnet-api.4160.nodely.dev
ALGOD_PORT=443
ALGOD_TOKEN=

INDEXER_SERVER=https://mainnet-idx.4160.nodely.dev
INDEXER_PORT=443
INDEXER_TOKEN=

# Contract IDs (update after deployment)
FACTORY_APP_ID=0
ROUTER_APP_ID=0

# CORS (comma-separated origins)
CORS_ORIGINS=https://fryswap.com,http://localhost:5173

# Cache TTL in seconds
CACHE_TTL=10
