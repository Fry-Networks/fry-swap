{
  "name": "fryswap",
  "version": "0.1.0",
  "description": "FrySwap - Multi-chain decentralized exchange, starting with Algorand",
  "private": true,
  "workspaces": [
    "packages/*",
    "api",
    "sdk"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "api:dev": "npm run dev --workspace=api",
    "api:start": "npm run start --workspace=api",
    "sdk:build": "npm run build --workspace=@fryswap/sdk"
  },
  "keywords": [
    "dex",
    "algorand",
    "amm",
    "defi",
    "swap",
    "liquidity"
  ],
  "author": "Fry Foundation",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  }
}
