{
  "name": "@fryswap/sdk",
  "version": "0.1.0",
  "description": "FrySwap SDK for interacting with the DEX",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "algosdk": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "algosdk": "^2.0.0"
  },
  "keywords": [
    "algorand",
    "dex",
    "amm",
    "sdk",
    "fryswap"
  ],
  "author": "Fry Foundation",
  "license": "MIT"
}
